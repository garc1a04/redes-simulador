{
    "protocol": "TCP",
    "description": "Máquina de Estados Finitos (FSM) impecável para o TCP, contemplando Handshake, Transferência de Dados, Teardown e Fechamento Simultâneo.",
    "initial_state": "CLOSED",
    "states": {
        "CLOSED": {
            "transitions": [
                {
                    "event": "app_passive_open",
                    "condition": null,
                    "action": "initialize_variables",
                    "next_state": "LISTEN",
                    "documentation": "Servidor abre o socket para escuta passiva."
                },
                {
                    "event": "app_active_open",
                    "condition": null,
                    "action": "send_syn_segment",
                    "next_state": "SYN_SENT",
                    "documentation": "Cliente inicia a conexão enviando SYN."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_segment",
                    "next_state": "CLOSED",
                    "documentation": "Responde com ACK a FINs perdidos/retransmitidos pelo par que ainda está em LAST_ACK."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_dest_port_closed",
                    "action": "send_rst_segment",
                    "next_state": "CLOSED",
                    "documentation": "Conexão para uma porta fechada gera um Reset (RST)."
                }
            ]
        },
        "LISTEN": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_syn",
                    "action": "send_syn_ack_segment",
                    "next_state": "SYN_RCVD",
                    "documentation": "Recebe SYN e responde com SYN-ACK."
                }
            ]
        },
        "SYN_SENT": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_syn_ack",
                    "action": "send_ack_segment",
                    "next_state": "ESTABLISHED",
                    "documentation": "Recebe SYN-ACK, envia ACK final e conclui Handshake."
                },
                {
                    "event": "timeout",
                    "condition": "is_syn_timeout",
                    "action": "resend_syn_segment",
                    "next_state": "SYN_SENT",
                    "documentation": "Timeout do SYN. Retransmite."
                }
            ]
        },
        "SYN_RCVD": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_ack",
                    "action": "handle_ack",
                    "next_state": "ESTABLISHED",
                    "documentation": "Recebe o ACK final. A ação 'handle_ack' cancela o temporizador de SYN pendente."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_syn",
                    "action": "send_syn_ack_segment",
                    "next_state": "SYN_RCVD",
                    "documentation": "Recebe SYN duplicado e responde com novo SYN-ACK."
                },
                {
                    "event": "timeout",
                    "condition": "is_syn_timeout",
                    "action": "resend_syn_ack_segment",
                    "next_state": "SYN_RCVD",
                    "documentation": "Timeout aguardando o ACK do cliente. Retransmite SYN-ACK."
                }
            ]
        },
        "ESTABLISHED": {
            "transitions": [
                {
                    "event": "app_close",
                    "condition": null,
                    "action": "send_fin_segment",
                    "next_state": "FIN_WAIT_1",
                    "documentation": "Aplicação solicita encerramento. Envia FIN."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_segment",
                    "next_state": "CLOSE_WAIT",
                    "documentation": "Recebe o FIN do outro lado e responde com ACK."
                },
                {
                    "event": "app_send_data",
                    "condition": null,
                    "action": "send_data_segment_and_start_timer",
                    "next_state": "ESTABLISHED",
                    "documentation": "Aplicação envia dados."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_valid_data",
                    "action": "send_cumulative_ack",
                    "next_state": "ESTABLISHED",
                    "documentation": "Recebe dados válidos e envia ACK cumulativo."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_duplicate_ack_3",
                    "action": "fast_retransmit",
                    "next_state": "ESTABLISHED",
                    "documentation": "Recebe 3 ACKs duplicados. Dispara retransmissão rápida."
                },
                {
                    "event": "timeout",
                    "condition": "is_data_timeout",
                    "action": "retransmit_oldest_unacked_segment",
                    "next_state": "ESTABLISHED",
                    "documentation": "Timeout de dados. Retransmite o segmento mais antigo."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_new_ack",
                    "action": "process_new_ack",
                    "next_state": "ESTABLISHED",
                    "documentation": "Recebe novo ACK. Atualiza RTT e recomeça o timer."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_syn_ack",
                    "action": "send_ack_segment",
                    "next_state": "ESTABLISHED",
                    "documentation": "Trata SYN-ACKs duplicados atrasados na rede."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_duplicate_ack",
                    "action": "ignore",
                    "next_state": "ESTABLISHED",
                    "documentation": "Ignora pacificamente o 1º, 2º e os ACKs duplicados subsequentes ao 3º."
                }
            ]
        },
        "FIN_WAIT_1": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_ack",
                    "action": "cancel_fin_timer",
                    "next_state": "FIN_WAIT_2",
                    "documentation": "Recebe ACK para o FIN enviado. Cancela o timer e aguarda o FIN do outro lado."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_segment",
                    "next_state": "CLOSING",
                    "documentation": "Fechamento simultâneo: Recebe FIN antes de receber o ACK do seu próprio FIN."
                },
                {
                    "event": "timeout",
                    "condition": "is_fin_timeout",
                    "action": "resend_fin_segment",
                    "next_state": "FIN_WAIT_1",
                    "documentation": "Timeout do FIN enviado. Retransmite."
                }
            ]
        },
        "FIN_WAIT_2": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_and_start_time_wait_timer",
                    "next_state": "TIME_WAIT",
                    "documentation": "Recebe o FIN final do outro lado. Envia ACK e entra em espera (2MSL)."
                }
            ]
        },
        "CLOSING": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_ack",
                    "action": "start_time_wait_timer",
                    "next_state": "TIME_WAIT",
                    "documentation": "Recebe o ACK que faltava no fechamento simultâneo."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_segment",
                    "next_state": "CLOSING",
                    "documentation": "Trata FINs duplicados enquanto está em CLOSING."
                },
                {
                    "event": "timeout",
                    "condition": "is_fin_timeout",
                    "action": "resend_fin_segment",
                    "next_state": "CLOSING",
                    "documentation": "Timeout do FIN enviado no fechamento simultâneo."
                }
            ]
        },
        "TIME_WAIT": {
            "transitions": [
                {
                    "event": "timeout",
                    "condition": "is_2msl_timeout",
                    "action": "delete_tcb",
                    "next_state": "CLOSED",
                    "documentation": "Timer de 2MSL expirou. Conexão completamente encerrada."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_segment",
                    "next_state": "TIME_WAIT",
                    "documentation": "Recebe FIN duplicado. Reenvia ACK e continua esperando no TIME_WAIT."
                }
            ]
        },
        "CLOSE_WAIT": {
            "transitions": [
                {
                    "event": "app_close",
                    "condition": null,
                    "action": "send_fin_segment",
                    "next_state": "LAST_ACK",
                    "documentation": "Aplicação do servidor finalmente decide fechar a conexão."
                },
                {
                    "event": "channel_receive_segment",
                    "condition": "is_fin",
                    "action": "send_ack_segment",
                    "next_state": "CLOSE_WAIT",
                    "documentation": "Recebe FIN duplicado e reenvia o ACK para garantir."
                }
            ]
        },
        "LAST_ACK": {
            "transitions": [
                {
                    "event": "channel_receive_segment",
                    "condition": "is_ack",
                    "action": "delete_tcb",
                    "next_state": "CLOSED",
                    "documentation": "Recebe o último ACK. TCB deletado e conexão encerrada."
                },
                {
                    "event": "timeout",
                    "condition": "is_fin_timeout",
                    "action": "resend_fin_segment",
                    "next_state": "LAST_ACK",
                    "documentation": "Timeout do último FIN. Retransmite até receber o ACK final."
                }
            ]
        }
    }
}